# Environment variables that can set by CI:
# - WITH_TEST_KEYS=1 - enable use of testing keys

pkgname=snapd
pkgdesc="Service and tools for management of snap packages."
depends=('squashfs-tools' 'libseccomp' 'libsystemd' 'libcap' 'apparmor')
optdepends=('bash-completion: bash completion support'
            'xdg-desktop-portal: desktop integration')
pkgver=2.78
pkgrel=1
arch=('x86_64' 'i686' 'armv7h' 'aarch64')
url="https://github.com/snapcore/snapd"
license=('GPL3')
makedepends=('meson' 'git' 'go' 'go-tools' 'libseccomp' 'libcap' 'systemd' 'xfsprogs' 'python-docutils' 'apparmor' 'm4')
# the following checkdepends are only required for static checks and unit tests,
# unit tests are currently enabled
checkdepends=('python' 'squashfs-tools' 'shellcheck' 'openssh')
checkdepends_x86_64=('lib32-glibc')
conflicts=('snap-confine')
options=('!strip' 'emptydirs')
install=snapd.install
source=("${pkgname}-${pkgver}.tar.xz")
sha256sums=('SKIP')

build() {
  arch-meson "$pkgname-$pkgver" build \
             -Ddracut=disabled \
             -Dsetcap=false \
             -Dsecboot=false \
             -Dsnapmountdir=/var/lib/snapd/snap \
             -Dbpf=enabled
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}

#!/bin/bash -e

show_help() {
    echo "usage: remote.exec [--user <USER>] [--pass <PASS>] <CMD>"
    echo ""
    echo "Available options:"
    echo "  -h --help   show this help message."
    echo ""
}

_load_config() {
    local CFG_FILE
    CFG_FILE="$(remote.setup get-config-path)"
    if [ ! -f "$CFG_FILE" ]; then
        echo "remote.exec: config file \"$CFG_FILE\" not found, please run remote.setup command first"
        return 1
    fi
    # shellcheck disable=SC1090
    . "$CFG_FILE"
}

_get_pass() {
    local SSH_PASS
    if [ -n "$TESTS_REMOTE_PASS" ]; then
        echo "sshpass -p $TESTS_REMOTE_PASS"
    fi
}

_get_key() {
    if [ -n "$TESTS_REMOTE_PASS" ]; then
        return
    elif [ -n "$TESTS_REMOTE_KEY" ]; then
        echo "-i $TESTS_REMOTE_KEY"
    fi
}

_get_auth_id() {
    local control_dir="$1"
    local salt_file="$control_dir/auth-salt"

    if [ ! -f "$salt_file" ]; then
        (umask 077 && head -c 32 /dev/urandom > "$salt_file")
    fi

    if [ -n "$TESTS_REMOTE_PASS" ]; then
        { cat "$salt_file"; printf '\0password\0%s' "$TESTS_REMOTE_PASS"; } | sha256sum | cut -c 1-16
    elif [ -n "$TESTS_REMOTE_KEY" ]; then
        { cat "$salt_file"; printf '\0key\0'; cat "$TESTS_REMOTE_KEY"; } | sha256sum | cut -c 1-16
    else
        { cat "$salt_file"; printf '\0default\0%s' "${SSH_AUTH_SOCK:-}"; } | sha256sum | cut -c 1-16
    fi
}

_get_control_path() {
    local auth_id control_dir endpoint_id
    control_dir="${TESTS_REMOTE_CONTROL_DIR:-/tmp/remote-exec-$UID}"
    mkdir -p "$control_dir"
    chmod 700 "$control_dir"
    auth_id="$(_get_auth_id "$control_dir")"
    # shellcheck disable=SC2153
    endpoint_id="$(printf '%s\0%s\0%s' "$TESTS_REMOTE_HOST" "$TESTS_REMOTE_PORT" "$TESTS_REMOTE_USER" | sha256sum | cut -c 1-16)"
    echo "$control_dir/remote-exec-$endpoint_id-$auth_id"
}

_ssh_exec() {
    local timeout="$1"
    shift

    # shellcheck disable=SC2153,SC2086
    $SSH_PASS ssh $SSH_KEY -p "$TESTS_REMOTE_PORT" -o LogLevel=ERROR -o ServerAliveInterval=10 -o ConnectTimeout="$timeout" -o ControlMaster=auto -o ControlPersist=10m -o ControlPath="$SSH_CONTROL_PATH" -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no "$TESTS_REMOTE_USER"@"$TESTS_REMOTE_HOST" "$@"
}

_remove_stale_control_socket() {
    if [ -S "$SSH_CONTROL_PATH" ] && ! ssh -S "$SSH_CONTROL_PATH" -O check "$TESTS_REMOTE_USER"@"$TESTS_REMOTE_HOST" >/dev/null 2>&1; then
        rm -f "$SSH_CONTROL_PATH"
    fi
}

remote_exec() {
    local user pass
    local timeout=10
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)
                show_help
                exit
                ;;
            --user)
                user="$2"
                shift 2
                ;;
            --pass)
                pass="$2"
                shift 2
                ;;
            --timeout)
                timeout="$2"
                shift 2
                ;;
            -*)
                echo "remote.exec: unknown option $1" >&2
                exit 1
                ;;
            *)
                break    
                ;;
        esac
    done

    _load_config
    if [ -n "$user" ]; then
        TESTS_REMOTE_USER="$user"
    fi
    if [ -n "$pass" ]; then
        TESTS_REMOTE_PASS="$pass"
    fi

    local SSH_PASS SSH_KEY SSH_CONTROL_PATH
    SSH_PASS="$(_get_pass)"
    SSH_KEY="$(_get_key)"
    SSH_CONTROL_PATH="$(_get_control_path)"

    _remove_stale_control_socket
    _ssh_exec "$timeout" "$@"
}

main() {    
    remote_exec "$@"
}

main "$@"
